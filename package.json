{
  "name": "paper-pdf-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build:app": "tauri build --bundles app",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "description": "A quiet, focused, native-feeling PDF reader built with Tauri, React and PDF.js.",
  "license": "MIT",
  "author": "Xiaolong Zhang <11617214+XiaolongZhang-TT@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaolongZhang-TT/pdf-reader.git"
  },
  "homepage": "https://github.com/XiaolongZhang-TT/pdf-reader#readme",
  "bugs": {
    "url": "https://github.com/XiaolongZhang-TT/pdf-reader/issues"
  },
  "keywords": [
    "pdf",
    "pdf-reader",
    "tauri",
    "react",
    "pdfjs",
    "macos",
    "windows",
    "linux",
    "desktop"
  ],
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.14.0"
}
